# Copy to .env next to stackfit.json (it is gitignored). Never commit real values.

# Optional: where this catalog lives, so stackfit works from any folder.
# STACKFIT_CATALOG=~/code/my-skill-catalog

# Optional: lets `stackfit refresh` read private GitHub repositories.
# GITHUB_TOKEN=

# Any NAME here can be used as {{env:NAME}} in commands/, rules/, and agents/, e.g.
# REVIEWER_HANDLE=@your-handle
