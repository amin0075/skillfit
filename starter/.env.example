# Copy to .env next to skillfit.json (it is gitignored). Never commit real values.

# Optional: where this catalog lives, so skillfit works from any folder.
# SKILLFIT_CATALOG=~/code/my-skill-catalog

# Optional: lets `skillfit refresh` read private GitHub repositories.
# GITHUB_TOKEN=

# Any NAME here can be used as {{env:NAME}} in commands/, rules/, and agents/, e.g.
# REVIEWER_HANDLE=@your-handle
