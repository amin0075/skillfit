# skillfit reads these from your shell, ./.env, or the catalog's .env (never commit .env).

# Where your catalog lives, so skillfit works from any folder. Default: ~/.skillfit
SKILLFIT_CATALOG=

# Optional: another machine-profile file instead of <catalog>/skillfit.local.json
SKILLFIT_LOCAL_CONFIG=

# Optional: read access to private GitHub repositories for `skillfit refresh`.
# Sent as a one-off HTTP header; never written to disk or logs.
GITHUB_TOKEN=

# Anything else fills {{env:NAME}} placeholders in your catalog's commands, rules, and agents, e.g.
# REVIEWER_HANDLE=@your-handle
